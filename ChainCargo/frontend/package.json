{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names API,VITE \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:local": "concurrently --kill-others --names API,VITE \"node --env-file=.env.hardhat server.js\" \"vite --mode hardhat\"",
    "dev:api": "node server.js",
    "dev:ui": "vite --configLoader runner",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "npm run test:ui && npm run test:contracts",
    "check": "npm run lint && npm run test && npm run build",
    "chain": "hardhat node",
    "compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "test:ui": "node --test test-ui/*.test.js",
    "deploy:sepolia": "hardhat run scripts/deploy.cjs --network sepolia",
    "deploy:local": "hardhat run scripts/deploy.cjs --network localhost",
    "seed:local": "hardhat run scripts/seed-local.cjs --network localhost",
    "demo:local": "npm run deploy:local && npm run seed:local"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "chai": "^4.5.0",
    "concurrently": "^10.0.4",
    "dotenv": "^17.2.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "hardhat": "^2.26.3",
    "vite": "^8.1.1"
  }
}
