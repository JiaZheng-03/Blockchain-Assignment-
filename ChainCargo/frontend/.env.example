SEPOLIA_RPC_URL=https://your-sepolia-rpc-provider.example/v2/api-key
DEPLOYER_PRIVATE_KEY=YOUR_DEPLOYER_PRIVATE_KEY

# Sepolia is the default. The deploy script writes Sepolia metadata only to
# src/contracts/deployment.json. Set an address only for a deliberate override.
VITE_ESCROW_CONTRACT_ADDRESS=
VITE_ESCROW_CHAIN_ID=11155111

# Server-only Supabase settings. Use a dedicated project and keep the secret key
# out of Vite/browser variables. The API creates or updates this public bucket
# with the app's 10 MB and MIME-type restrictions.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_SECRET
SUPABASE_STORAGE_BUCKET=cargoseal-evidence
CARGOSEAL_API_PORT=3001
